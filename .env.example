# Скопируйте этот файл в .env и заполните своими значениями: cp .env.example .env

# --- Доступ к Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- LLM API (OpenAI-совместимый формат) ---
# Базовый URL: https://api.openai.com/v1 или любой OpenAI-совместимый провайдер.
# Смена провайдера = правка LLM_API_URL и LLM_MODEL парой.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Модель по умолчанию (можно переопределить в конфиге клиента -> llm.model)
LLM_MODEL=gpt-6-luna

# --- Конфиг клиента ---
# Какой файл из config/ использовать. По умолчанию client_config.yaml.
# Расширение .yaml можно не писать: CLIENT_CONFIG=client_config_nails_atyrau
# Готовые конфиги: client_config (Global Coffee Kazygurt), client_config_global_coffee,
# client_config_cofee, client_config_nails, client_config_nails_atyrau, client_config_cloth.
# Одна копия проекта = один клиент: задайте здесь нужный конфиг и свой
# TELEGRAM_BOT_TOKEN — и деплойте хоть несколько копий (Railway/Render).
CLIENT_CONFIG=client_config.yaml

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# (необязательно) Перекрывает owner_telegram_chat_id из client_config.yaml —
# для тестирования уведомлений с отдельного аккаунта без правки конфига клиента.
OWNER_CHAT_ID_OVERRIDE=
